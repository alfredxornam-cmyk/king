rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId == request.auth.uid && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() <= 100 &&
             data.email is string && data.email.size() <= 150 &&
             data.vaultSalt is string && data.vaultSalt.size() >= 8 && data.vaultSalt.size() <= 128 &&
             data.encryptionEnabled is bool &&
             data.themeMode in ['DARK', 'LIGHT', 'HACKER'] &&
             (!('activeAiThemeJson' in data) || (data.activeAiThemeJson is string && data.activeAiThemeJson.size() <= 2000)) &&
             data.aiModelName in ['gemini-3.8-flash', 'gemini-3.5-flash-lite'] &&
             data.aiTemperature is number && data.aiTemperature >= 0.0 && data.aiTemperature <= 1.0 &&
             data.autoStructureVoice is bool;
    }

    function isValidTask(data) {
      return data.userId is string && data.userId == request.auth.uid && data.userId.size() <= 128 &&
             data.titleCipher is string && data.titleCipher.size() >= 1 && data.titleCipher.size() <= 2000 &&
             data.noteCipher is string && data.noteCipher.size() <= 10000 &&
             data.encrypted is bool &&
             data.completed is bool &&
             data.lane in ['FOCUS', 'PROGRESS', 'DONE'] &&
             data.priority in ['HIGH', 'MEDIUM', 'LOW'] &&
             data.category is string && data.category.size() <= 50 &&
             data.sortOrder is int && data.sortOrder >= 0 && data.sortOrder <= 1000000 &&
             data.voiceCaptured is bool &&
             data.dueLabel is string && data.dueLabel.size() <= 60;
    }

    function isValidNote(data) {
      return data.userId is string && data.userId == request.auth.uid && data.userId.size() <= 128 &&
             data.titleCipher is string && data.titleCipher.size() >= 1 && data.titleCipher.size() <= 1000 &&
             data.contentCipher is string && data.contentCipher.size() <= 20000 &&
             data.encrypted is bool &&
             data.tags is list && data.tags.size() <= 10 &&
             (data.tags.size() == 0 || (data.tags[0] is string && data.tags[0].size() <= 40)) &&
             data.durationSec is int && data.durationSec >= 0 && data.durationSec <= 86400 &&
             (!('aiSummaryCipher' in data) || (data.aiSummaryCipher is string && data.aiSummaryCipher.size() <= 5000));
    }

    function isValidWallpaper(data) {
      return data.userId is string && data.userId == request.auth.uid && data.userId.size() <= 128 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             data.prompt is string && data.prompt.size() <= 1000 &&
             data.itemType in ['WALLPAPER', 'THEME'] &&
             (!('paletteJson' in data) || (data.paletteJson is string && data.paletteJson.size() <= 3000)) &&
             (!('imageBase64' in data) || (data.imageBase64 is string && data.imageBase64.size() <= 700000)) &&
             data.encrypted is bool &&
             data.deviceProfile is string && data.deviceProfile.size() <= 80;
    }

    function isValidVaultMedia(data) {
      return data.userId is string && data.userId == request.auth.uid && data.userId.size() <= 128 &&
             data.fileName is string && data.fileName.size() >= 1 && data.fileName.size() <= 160 &&
             data.mimeType is string && data.mimeType.size() >= 1 && data.mimeType.size() <= 80 &&
             data.sizeBytes is int && data.sizeBytes >= 0 && data.sizeBytes <= 2000000 &&
             data.cipherPayload is string && data.cipherPayload.size() >= 1 && data.cipherPayload.size() <= 850000 &&
             data.sha256Checksum is string && data.sha256Checksum.size() >= 8 && data.sha256Checksum.size() <= 128 &&
             data.encrypted is bool;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if isOwner(userId);

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().keys().hasAll([
                         'userId', 'displayName', 'email', 'vaultSalt',
                         'encryptionEnabled', 'themeMode', 'aiModelName',
                         'aiTemperature', 'autoStructureVoice', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'displayName', 'email', 'vaultSalt',
                         'encryptionEnabled', 'themeMode', 'activeAiThemeJson', 'aiModelName',
                         'aiTemperature', 'autoStructureVoice', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       isValidUserProfile(incoming());

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'displayName', 'email', 'vaultSalt', 'encryptionEnabled',
                         'themeMode', 'activeAiThemeJson', 'aiModelName',
                         'aiTemperature', 'autoStructureVoice', 'updatedAt'
                       ]);

      allow delete: if isOwner(userId) && isValidId(userId);

      match /tasks/{taskId} {
        allow get: if isOwner(userId) && isValidId(taskId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(taskId) &&
                         incoming().keys().hasAll([
                           'userId', 'titleCipher', 'noteCipher', 'encrypted',
                           'completed', 'lane', 'priority', 'category',
                           'sortOrder', 'voiceCaptured', 'dueLabel', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'titleCipher', 'noteCipher', 'encrypted',
                           'completed', 'lane', 'priority', 'category',
                           'sortOrder', 'voiceCaptured', 'dueLabel', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         isValidTask(incoming());

        allow update: if isOwner(userId) &&
                         isValidId(taskId) &&
                         isValidTask(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'titleCipher', 'noteCipher', 'encrypted', 'completed',
                           'lane', 'priority', 'category', 'sortOrder',
                           'voiceCaptured', 'dueLabel', 'updatedAt'
                         ]);

        allow delete: if isOwner(userId) && isValidId(taskId);
      }

      match /notes/{noteId} {
        allow get: if isOwner(userId) && isValidId(noteId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(noteId) &&
                         incoming().keys().hasAll([
                           'userId', 'titleCipher', 'contentCipher', 'encrypted',
                           'tags', 'durationSec', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'titleCipher', 'contentCipher', 'encrypted',
                           'tags', 'durationSec', 'aiSummaryCipher', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         isValidNote(incoming());

        allow update: if isOwner(userId) &&
                         isValidId(noteId) &&
                         isValidNote(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'titleCipher', 'contentCipher', 'encrypted',
                           'tags', 'durationSec', 'aiSummaryCipher', 'updatedAt'
                         ]);

        allow delete: if isOwner(userId) && isValidId(noteId);
      }

      match /wallpapers/{wallpaperId} {
        allow get: if isOwner(userId) && isValidId(wallpaperId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(wallpaperId) &&
                         incoming().keys().hasAll([
                           'userId', 'title', 'prompt', 'itemType',
                           'encrypted', 'deviceProfile', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'title', 'prompt', 'itemType',
                           'paletteJson', 'imageBase64', 'encrypted',
                           'deviceProfile', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         isValidWallpaper(incoming());

        allow update: if isOwner(userId) &&
                         isValidId(wallpaperId) &&
                         isValidWallpaper(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'title', 'prompt', 'itemType', 'paletteJson',
                           'imageBase64', 'encrypted', 'deviceProfile', 'updatedAt'
                         ]);

        allow delete: if isOwner(userId) && isValidId(wallpaperId);
      }

      match /vault_media/{mediaId} {
        allow get: if isOwner(userId) && isValidId(mediaId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(mediaId) &&
                         incoming().keys().hasAll([
                           'userId', 'fileName', 'mimeType', 'sizeBytes',
                           'cipherPayload', 'sha256Checksum', 'encrypted',
                           'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'fileName', 'mimeType', 'sizeBytes',
                           'cipherPayload', 'sha256Checksum', 'encrypted',
                           'createdAt', 'updatedAt'
                         ]) &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         isValidVaultMedia(incoming());

        allow update: if isOwner(userId) &&
                         isValidId(mediaId) &&
                         isValidVaultMedia(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'fileName', 'mimeType', 'sizeBytes',
                           'cipherPayload', 'sha256Checksum', 'encrypted', 'updatedAt'
                         ]);

        allow delete: if isOwner(userId) && isValidId(mediaId);
      }
    }
  }
}
